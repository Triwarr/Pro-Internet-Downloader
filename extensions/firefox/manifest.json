{
  "manifest_version": 2,
  "name": "Pro Internet Manager Bridge",
  "version": "0.3.3",
  "description": "Send links and media to the local Pro Internet Manager (by Triwar Design), including the current login cookies. Follows the app theme.",
  "browser_specific_settings": {
    "gecko": {
      "id": "rust-download-manager@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "downloads",
    "notifications",
    "cookies",
    "webRequest",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Pro Internet Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    "icons/*"
  ]
}
